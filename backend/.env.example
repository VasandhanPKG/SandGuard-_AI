# SandGuard Environment Configuration

# Core System
PROJECT_NAME="SandGuard AI Monitoring Platform"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Security
SECRET_KEY="super_secret_sandguard_jwt_key_change_in_production_min32chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL 16 + PostGIS)
POSTGRES_USER=sandguard
POSTGRES_PASSWORD=sandguard_secret_pass
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sandguard_db
DATABASE_URL=postgresql+asyncpg://sandguard:sandguard_secret_pass@localhost:5432/sandguard_db
SYNC_DATABASE_URL=postgresql://sandguard:sandguard_secret_pass@localhost:5432/sandguard_db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# AI & LLM Service Keys
GEMINI_API_KEY=""
OPENROUTER_API_KEY=""

# GIS & Storage Settings
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=500

# Email & Notification Settings
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
EMAILS_FROM_EMAIL="alerts@sandguard.gov"
EMAILS_FROM_NAME="SandGuard Monitoring Team"

# SMS API Settings (e.g. Twilio / Gateway)
SMS_API_KEY=""
SMS_SENDER_ID="SANDGUARD"
